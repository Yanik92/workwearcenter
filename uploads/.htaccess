Options -Indexes
<FilesMatch "\.(php[0-9]?|pht|phtml|phar|phps|cgi|pl|py|sh)$">
    Require all denied
</FilesMatch>

# Hochgeladene Listen und Datenexporte nie direkt ausliefern (z. B. Lieferantenpreise)
<FilesMatch "\.(json|csv|xlsx?|zip|txt|sql|log|bak)$">
    Require all denied
</FilesMatch>

# HTML/XML aus Uploads nie als Seite ausliefern (die Anwendung legt hier nur Bilder ab)
<FilesMatch "\.(s?html?|xhtml|xml|xsl)$">
    Require all denied
</FilesMatch>

# Logo-Dateien (SVG) nie als eigenständige Seite mit Skriptrechten ausliefern
<FilesMatch "\.svg$">
    Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
    Header set X-Content-Type-Options "nosniff"
</FilesMatch>
